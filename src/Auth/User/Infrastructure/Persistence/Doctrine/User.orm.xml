<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Auth\User\Domain\User" table="auth_users">
        <id name="id" type="user_id" column="id" length="36" />
        <embedded name="email" class="App\Auth\User\Domain\UserEmail" use-column-prefix="false" />
        <embedded name="fullName" class="App\Auth\User\Domain\UserFullName" use-column-prefix="false" />
        <embedded name="hashedPassword" class="App\Auth\User\Domain\UserHashedPassword" use-column-prefix="false" />
        <field name="createdAt" type="datetime_immutable" column="created_at" />
    </entity>

</doctrine-mapping>
